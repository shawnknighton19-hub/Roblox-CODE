-- The fixture above runs the retained V9/V11 datastore and round regressions first.
local owner=environment(true);local me,other=owner:add(701),owner:add(702);owner:step(0)
check(owner.Owner.IsOwner(me) and not owner.Owner.IsOwner(other),'published user creator is the only owner')
check(not owner.Owner.IsOwner({UserId=701,Parent=owner.players}),'table pretending to be a Player is denied')
local impostor=owner.instance('Player');impostor.UserId=701
check(not owner.Owner.IsOwner(impostor),'detached Player identity is denied')
other:SetAttribute('IsOwner',true);other:SetAttribute('HussOwner',true);other.Name=me.Name;other.DisplayName=me.DisplayName
check(not owner.Owner.IsOwner(other),'client-style owner attributes and matching names cannot authorize')
local ok=owner.E.GrantOwner(other,'coins','999999')
check(not ok and owner:last(other,'Profile').Coins==0,'direct server grant API independently rejects nonowner')
owner:chatCommand(other,'/grant all');owner:chatCommand(other,'/grant coins 5000')
check(owner:last(other,'OwnerCommand')==nil and owner:last(other,'Profile').Coins==0,'nonowner chat receives neither grants nor private owner help')
owner:remote(other,'GrantOwner','coins',70);owner:remote(other,'Grant','all',71)
check(owner:last(other,'Profile').Coins==0,'no client remote dispatches grants')
check(owner.chat:FindFirstChild('HussOwnerGrantV12').AutocompleteVisible==false and #owner.chat:GetChildren()==1,'Init rerun has one nonpublic command')
owner:chatCommand(me,'/grant help')
check(owner:last(me,'OwnerCommand').message:find('Studio balances are temporary',1,true)~=nil,'private help explains preview and genuine progression')
owner:step(2);owner:chatCommand(me,'/grant coins 10000')
check(owner:last(me,'Profile').Coins==10000 and owner:last(me,'OwnerCommand').ok and owner:last(me,'OwnerCommand').message:find('Studio preview: not saved',1,true),'modern chat grants exact requested Coins with preview notice')
owner:step(1);owner:chatCommand(me,'/grant bomb sUpErNoVa')
check(owner:last(me,'Profile').EquippedByCategory.Bombs=='bomb_nova' and table.find(owner:last(me,'Profile').Owned,'bomb_nova')~=nil,'case-insensitive catalog name unlocks and equips')
owner:step(1);owner:chatCommand(me,'/grant trail trail_comet')
check(owner:last(me,'Profile').Equipped=='trail_comet' and owner:last(me,'Profile').EquippedByCategory.Trails=='trail_comet','trail grant maintains legacy and category equipment equality')
owner:step(1);owner:chatCommand(me,'/grant title title_legend')
owner:step(1);owner:chatCommand(me,'/grant emote emote_robot')
check(owner:last(me,'Profile').EquippedByCategory.Titles=='title_legend' and owner:last(me,'Profile').EquippedByCategory.Emotes=='emote_robot','titles and emotes granted without currency charge')
local beforeAll=clone(owner:last(me,'Profile'));owner:step(1);owner:chatCommand(me,'/grant all')
local afterAll=owner:last(me,'Profile')
check(#afterAll.Owned==68 and afterAll.Coins==10000 and afterAll.EquippedByCategory.Bombs=='bomb_nova','grant all unlocks catalog, keeps equipment and balance')
for _,stat in ipairs({'Wins','Kills','FinalStands','GamesPlayed','Passes'}) do check(afterAll[stat]==beforeAll[stat],'owner grant never fabricates '..stat) end
for index,quest in ipairs(afterAll.Quests) do check(quest.progress==beforeAll.Quests[index].progress and quest.claimed==beforeAll.Quests[index].claimed,'owner grant never advances quest '..quest.id) end
owner:step(1);owner:chatCommand(me,'/grant all')
check(owner:last(me,'OwnerCommand').ok and owner:last(me,'OwnerCommand').message:find('already own',1,true),'repeat all is a harmless no-op')
owner:step(1);owner:chatCommand(me,'/grant list bombs')
check(owner:last(me,'OwnerCommand').message:find('bomb_champion',1,true),'private list includes exact catalog IDs')
for _,invalid in ipairs({'-1','1.5','nan','inf','2000000001','1e4','0','99999999999999999999','100 702'}) do
 owner:step(1);local before=owner:last(me,'Profile').Coins;owner:chatCommand(me,'/grant coins '..invalid)
 check(owner:last(me,'Profile').Coins==before and not owner:last(me,'OwnerCommand').ok,'invalid coin amount denied: '..invalid)
end
for _,invalid in ipairs({'/grant bomb title_legend','/grant kills 100','/grant wins 100','/grant all 702','/grant title made_up','/grant player 702 100','/grant bomb bomb_nova 702'}) do
 owner:step(1);owner:chatCommand(me,invalid)
 check(not owner:last(me,'OwnerCommand').ok and owner:last(me,'Profile').Coins==10000,'invalid category/target injection denied: '..invalid)
end
owner:step(1);owner:chatCommand(me,'/grant coins 2000000000')
check(owner:last(me,'Profile').Coins==2000000000,'coin grant caps balance at persisted MAX')
owner:step(1);owner:chatCommand(me,'/grant coins 1')
check(not owner:last(me,'OwnerCommand').ok and owner:last(me,'Profile').Coins==2000000000,'full wallet gives clear failure without mutation')
owner:step(1);local outputCount=#owner.outputs[me];owner:chatCommand(me,string.rep('x',161));owner:chatCommand(me,'/grant coins 1'..string.char(0))
check(#owner.outputs[me]==outputCount,'oversized and control character text discarded')
local fast=environment(true);local fp=fast:add(701);fast:step(0)
check(fast.E.GrantOwner(fp,'coins',1),'first direct owner grant succeeds')
check(not fast.E.GrantOwner(fp,'coins',1) and fast:last(fp,'Profile').Coins==1,'direct API rate limit cannot duplicate a burst')
local loading=environment(false);loading.delay=2;local lp=loading:add(701)
check(not loading.E.GrantOwner(lp,'coins',500),'owner grant rejects unloaded profile')
loading:step(3);check(loading.E.GrantOwner(lp,'coins',500),'owner grant accepts safely loaded profile')
loading:step(13);check(loading.profiles.u701.Coins==500,'owner grant uses existing durable transaction')
loading:remove(lp);loading:step(3);check(not loading.E.GrantOwner(lp,'coins',500),'owner leaving game cannot mutate stale record')
local again=loading:add(701);loading:step(3)
check(loading:last(again,'Profile').Coins==500,'granted currency survives lease release and rejoin')
local lease=environment(false);local leased=lease:add(701);lease:step(0)
lease.profiles.u701.Lease.token='another-server';lease.E.GrantOwner(leased,'coins',50);lease:step(0)
check(not lease:last(leased,'Profile').ready and not lease.E.GrantOwner(leased,'coins',500),'lost datastore lease blocks subsequent owner grants')
check(lease.profiles.u701.Coins==0,'owner grants never overwrite another server lease')
local legacyChat=environment(true,nil,nil,{chatVersion='Legacy'});local legacyOwner=legacyChat:add(701);legacyChat:step(0)
legacyChat:chatCommand(legacyOwner,'/hussgrant coins 75')
check(legacyChat:last(legacyOwner,'Profile').Coins==75 and #legacyChat.chat:GetChildren()==0,'legacy Chatted fallback grants once with no modern registration')
me.Chatted:Fire('/grant coins 1')
check(owner:last(me,'Profile').Coins==2000000000,'modern mode does not bind legacy Chatted')
for _,alias in ipairs({'/grant','/hussgrant','/GRANT'}) do
 local conflict=environment(true,nil,nil,{commandConflict=alias});local cp=conflict:add(701);conflict:step(0)
 check(conflict.chat:FindFirstChild('HussOwnerGrantV12')==nil and #conflict.warns==1 and #conflict.chat:GetChildren()==1,'foreign command preserved and registration refused: '..alias)
end
local unknown=environment(true,nil,nil,{creatorId=0});local up=unknown:add(701);unknown:step(0)
check(not unknown.Owner.IsOwner(up) and not unknown.E.GrantOwner(up,'coins',1),'unpublished CreatorId zero fails closed, including Studio')
local group=environment(true,nil,nil,{creatorType='Group',creatorId=1234,groupOwner=701});local go,gn=group:add(701),group:add(702);group:step(0)
check(group.Owner.IsOwner(go) and not group.Owner.IsOwner(gn) and group.groupCalls==1,'group creator resolves actual Owner.Id on server and caches lookup')
group.groupInfo={Owner={Id=702}};group:step(31)
check(not group.Owner.IsOwner(go) and group.Owner.IsOwner(gn) and group.groupCalls==2,'group ownership transfer revokes former owner after 30 second cache')
group:step(31);group.groupFail=true
check(not group.Owner.IsOwner(go) and not group.Owner.IsOwner(gn),'lookup failure after cache expiry denies everyone and drops old identity')
group.groupFail=false;group.groupInfo={};group:step(6)
check(not group.Owner.IsOwner(gn),'ownerless group fails closed')
group.groupInfo={Owner={Id='702'}};group:step(6)
check(not group.Owner.IsOwner(gn),'malformed numeric owner ID fails closed')
local wallet=environment(true);local buyer=wallet:add(701);wallet:step(0);wallet.E.GrantOwner(buyer,'coins',50000);wallet:step(1)
wallet.rawShop=true;buyer:SetAttribute('InRound',false)
local root=buyer.Character:FindFirstChild('HumanoidRootPart')
local function buyFails(id,reason)
 wallet:step(1);local before=wallet:last(buyer,'Profile').Coins;wallet:remote(buyer,'Buy',id,90)
 check(not wallet:last(buyer,'Profile').ok and wallet:last(buyer,'Profile').Coins==before,reason)
end
root.Position=wallet.vec(16.1,0,0);buyFails('bomb_ember','server rejects remote shop purchase beyond 16 studs')
root.Position=wallet.vec();buyer:SetAttribute('InRound',true);buyFails('bomb_ember','shop denied during real or practice rounds')
buyer:SetAttribute('InRound',false);buyer:SetAttribute('HussPracticeActive',true);buyFails('bomb_ember','explicit practice state cannot shop during transition')
buyer:SetAttribute('HussPracticeActive',false);buyer.Character:FindFirstChildOfClass('Humanoid').Health=0;buyFails('bomb_ember','dead players cannot shop')
buyer.Character:FindFirstChildOfClass('Humanoid').Health=100
wallet.anchors.Bombs:SetAttribute('HussShopStandEnabled',false);buyFails('bomb_ember','disabled stand cannot authorize purchase')
wallet.anchors.Bombs:SetAttribute('HussShopStandEnabled',true);wallet.anchors.Bombs:SetAttribute('HussShopCategory','Trails');buyFails('bomb_ember','wrong category stand cannot authorize purchase')
wallet.anchors.Bombs:SetAttribute('HussShopCategory','Bombs')
local stand=wallet.anchors.Bombs;local originalParent=stand.Parent;stand.Parent=wallet.workspace;buyFails('bomb_ember','tagged part outside actual lobby kiosk cannot authorize purchase');stand.Parent=originalParent
root.Position=wallet.vec(16,0,0);wallet:step(1);wallet:remote(buyer,'Buy','bomb_ember',91)
check(wallet:last(buyer,'Profile').ok and wallet:last(buyer,'Profile').Coins==49400,'valid matching lobby stand charges real catalog price at server radius boundary')
root.Position=wallet.vec(1000,0,0);wallet:step(1);wallet:remote(buyer,'Equip','bomb_classic',92)
check(wallet:last(buyer,'Profile').ok and wallet:last(buyer,'Profile').EquippedByCategory.Bombs=='bomb_classic','owned inventory can equip away from stand')
-- Practice snapshot checks every persistent statistic and quest, not just wins.
local practice=environment(true);local pr=practice:add(701);practice:step(0)
local beforePractice=clone(practice:last(pr,'Profile'))
local bot={UserId=-100,Name='Practice',Parent=practice.players,Character=pr.Character,GetAttribute=function() return true end,IsA=function() return true end}
practice.E.BeginRound({pr,bot});practice.E.Pass(pr,bot);practice.E.FinalStand({pr,bot});practice.E.Elimination(pr,bot);practice.E.EndRound(pr)
local afterPractice=practice:last(pr,'Profile')
for _,stat in ipairs({'Coins','Wins','Kills','FinalStands','GamesPlayed','Passes'}) do check(afterPractice[stat]==beforePractice[stat],'solo practice never changes '..stat) end
for index,quest in ipairs(afterPractice.Quests) do check(quest.progress==beforePractice.Quests[index].progress and quest.claimed==beforePractice.Quests[index].claimed,'solo practice never changes quest '..quest.id) end
check(practice.E.GrantOwner(pr,'coins',25) and practice:last(pr,'Profile').Coins==25,'explicit owner grant is separate from earned practice rewards')
print('Economy and owner V12 checks passed:',checks)
