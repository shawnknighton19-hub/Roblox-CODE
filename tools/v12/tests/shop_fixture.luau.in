for index,category in ipairs({'Bombs','Trails','Titles','Emotes'}) do
 local station=Instance.new('Model',exchange);station.Name=category..' kiosk'
 local counter=Instance.new('Part',station);counter.Name='Counter';counter.CFrame=CFrame.new(index*100,2,4.7)
 local anchor=Instance.new('Part',station);anchor.Name='Browse '..category;anchor.Position=Vector3.new(index*100,5.5,7.5);anchor.CFrame=CFrame.new(anchor.Position);anchors[category]=anchor
 local prompt=Instance.new('ProximityPrompt',anchor);prompt.Name='BrowseShop';prompt:SetAttribute('HussShopCategory',category);prompt.Enabled=true
end
local ShopStands=(function()
{{WORLD}}
end)()

ShopStands.Apply(lobby)
check(lobby:GetAttribute('HussLobbyVersion')==11,'preserve V11 lobby world version')
check(ShopStands.Validate(lobby),'validate complete shop geometry')
local beforeCount=#lobby:GetDescendants()
local originalPanel=anchors.Bombs.Parent.ShopPanelV12
ShopStands.Apply(lobby)
check(#lobby:GetDescendants()==beforeCount and originalPanel==anchors.Bombs.Parent.ShopPanelV12,'reapply preserves same physical panels with no duplicates')
check(#CS:GetTagged('HussShopStandV12')==4,'four tagged stand approach anchors')
for category,anchor in pairs(anchors) do
 local panel=anchor.Parent.ShopPanelV12
 check(panel.CFrame.Position.Z>anchor.Parent.Counter.CFrame.Position.Z+2.4,'panel is in front of counter '..category)
 check(panel.CFrame.Position.Y+panel.Size.Y/2<8,'panel below original overhead sign '..category)
 check(not panel.CanCollide and not panel.CanTouch and panel.CanQuery,'walk-through cosmetic panel is ray-queryable for UI '..category)
 check(anchor.HussShopCategory==nil and anchor:GetAttribute('HussShopCategory')==category,'category stored in server attribute '..category)
 check(panel.ShopIdleV12.CanvasSize.X==1140 and panel.ShopIdleV12.CanvasSize.Y==432,'high resolution world face '..category)
end
local tampered=lobby:Clone();tampered.Bogus=true;tampered['V11 Bomb Exchange']['Bombs kiosk'].ShopPanelV12.CanCollide=true
check(not pcall(ShopStands.Validate,tampered),'reject changed panel collision flags on rerun');tampered:Destroy()
local unknown=lobby:Clone();unknown:SetAttribute('HussShopVersion',13)
check(not pcall(ShopStands.Apply,unknown),'reject unrecognized shop version');unknown:Destroy()
local HUD=(function()
{{HUD}}
end)()
HUD.Init()
local script=Instance.new("LocalScript")
script.Name="StandShopV12"
(function()
{{CLIENT}}
end)()

local owned={'bomb_classic','default','title_rookie','emote_wave'}
local equips={Bombs='bomb_classic',Trails='default',Titles='title_rookie',Emotes='emote_wave'}
local function profile(ticket,coins,ok,msg)
 economy.OnClientEvent:Fire({kind='Profile',requestId=ticket,ready=true,mode='preview',Coins=coins or 10000,Catalog=productionCatalog.Items,Quests={},Owned=owned,EquippedByCategory=equips,ok=ok~=false,message=msg or ''})
end
local function shop() return playerGui:FindFirstChild('HussStandShopV12') end
local function node(name,parent) return (parent or shop()):FindFirstChild(name,true) end
local function move(category,distance)
 rootPart.Position=anchors[category].Position+Vector3.new(0,0,distance or 7);tickFrame(.11)
end
local function lastCall() return serverCalls[#serverCalls].args end
profile();tickFrame(.11)
check(not shop(),'shop absent outside approach radius')
move('Bombs',11)
check(shop() and shop().Adornee==originalPanel,'walk-up mounts private SurfaceGui to physical Bombs counter')
check(player:GetAttribute('HussShopBrowsingV12')=='Bombs','HUD notified of shop approach')
check(not originalPanel.ShopIdleV12.Enabled,'local idle face hidden behind active shop')
check(UserInputService.MouseBehavior==Enum.MouseBehavior.Default and UserInputService.MouseIconEnabled==true,'shift lock cursor unlocked and visible while browsing')
check(node('BuyEquip'):GetAttribute('HussDisabled')==true,'equipped default cannot be charged again')
check(node('PreviewBomb'):GetAttribute('HussBombSculptureVersion')==12,'actual shared bomb geometry preview built')
node('Select_bomb_cherry').Activated:Fire()
node('BuyEquip').Activated:Fire()
local ticket=lastCall()[3]
check(lastCall()[1]=='Buy' and lastCall()[2]=='bomb_cherry' and ticket>1000000000,'buy sends validated ID in stand request namespace')
check(node('BuyEquip'):GetAttribute('HussDisabled') and node('BuyEquip').Caption.Text=='PLEASE WAIT…','pending purchase disables button')
local callCount=#serverCalls;node('BuyEquip').Activated:Fire()
check(#serverCalls==callCount,'double-click sends only one purchase')
profile(5,9000)
check(node('BuyEquip').Caption.Text=='PLEASE WAIT…','unrelated HUD response does not clear pending shop purchase')
owned[#owned+1]='bomb_cherry';equips.Bombs='bomb_cherry'
profile(ticket,9800,true,'Cherry Pop equipped!')
check(node('Coins').Text=='9,800 COINS','wallet uses authoritative returned profile')
check(node('Status').Text=='Cherry Pop equipped!' and node('BuyEquip').Caption.Text=='EQUIPPED','matching response confirms ownership and equips')
local seen={}
for page=1,5 do
 for _,o in ipairs(shop():GetDescendants()) do if o.Name:sub(1,7)=='Select_' then seen[o.Name:sub(8)]=true end end
 if page<5 then node('Next').Activated:Fire() end
end
local seenCount=0;for _ in pairs(seen) do seenCount+=1 end
check(seenCount==25,'all 25 bombs accessible through five pages')
check(node('Next'):GetAttribute('HussDisabled'),'last page Next disabled')
profile(nil,0)
check(node('BuyEquip'):GetAttribute('HussDisabled') and node('BuyEquip').Caption.Text:find('NEED'),'cannot buy unaffordable selected item')
move('Bombs',13.5);check(shop()~=nil,'approach hysteresis keeps shop open inside 14 studs')
move('Bombs',14.1);check(shop()==nil,'walk-away closes physical shop')
check(originalPanel.ShopIdleV12.Enabled,'idle face restored after leaving')
check(UserInputService.MouseBehavior==Enum.MouseBehavior.LockCenter and UserInputService.MouseIconEnabled==false,'leaving restores pre-shop mouse state')
move('Bombs',13);check(shop()==nil,'outside 12 studs does not reopen')
move('Bombs',11);check(shop()~=nil,'reenter approach opens shop again')
node('Close').Activated:Fire();tickFrame(.11);check(shop()==nil,'manual close stays dismissed while inside approach zone')
move('Bombs',15);move('Bombs',10);check(shop()~=nil,'leave and return clears dismissed state')
player:SetAttribute('InRound',true);check(shop()==nil,'joining round immediately closes shop')
tickFrame(.11);check(shop()==nil,'shop unavailable during live round')
player:SetAttribute('InRound',false);tickFrame(.11);check(shop()~=nil,'shop can reopen in lobby')
player:SetAttribute('HussPracticeActive',true);check(shop()==nil,'practice flag closes shop')
player:SetAttribute('HussPracticeActive',false);tickFrame(.11)
humanoid.Health=0;tickFrame(.11);check(shop()==nil,'death closes shop')
humanoid.Health=100;tickFrame(.11)
anchors.Bombs:SetAttribute('HussShopStandEnabled',false);tickFrame(.11);check(shop()==nil,'server disabling anchor closes shop')
anchors.Bombs:SetAttribute('HussShopStandEnabled',true);tickFrame(.11)
-- A stale tagged part in a backup cannot open a shop.
local backup=lobby:Clone();backup.Name='Backup';backup.Parent=workspace
move('Bombs',16);rootPart.Position=backup['V11 Bomb Exchange']['Bombs kiosk']['Browse Bombs'].Position+Vector3.new(1000,0,0);tickFrame(.11);check(not shop(),'tagged backup parts ignored outside live Lobby');backup:Destroy()
for _,category in ipairs({'Trails','Titles','Emotes'}) do
 move(category,8)
 check(shop() and player:GetAttribute('HussShopBrowsingV12')==category,'walk-up activates '..category..' station')
 check(node('SelectedName')~=nil,'selected '..category..' item details shown')
end
check(node('PlayEmote') and not node('PlayEmote'):GetAttribute('HussDisabled'),'equipped emote playable at stand')
node('PlayEmote').Activated:Fire();check(lastCall()[1]=='Emote' and lastCall()[2]=='emote_wave','stand plays actual equipped emote through server')
player:SetAttribute('HussEmotePlaying','emote_wave');check(node('PlayEmote').Caption.Text=='STOP','live emote status updates button')
node('PlayEmote').Activated:Fire();check(lastCall()[1]=='StopEmote','stop emote uses existing server controller')
move('Emotes',16);lastInput=Enum.UserInputType.Gamepad1;move('Bombs',8)
check(GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(shop()),'gamepad focus targets physical shop button')
UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.ButtonB},false);check(shop()==nil and GuiService.SelectedObject==nil,'gamepad B closes stand and releases selection')
lastInput=Enum.UserInputType.Keyboard;move('Bombs',16);move('Bombs',8)
node('Refresh').Activated:Fire();local syncTicket=lastCall()[3]
tickFrame(10.1);check(node('Status').Text:find('No reply yet'),'timeout explains unconfirmed result')
profile(syncTicket,9999);check(node('Coins').Text=='9,999 COINS','late profile still updates authoritative balance')
-- HUD collection is inventory-only; no global Shop button or Index purchase path remains.
local hud=playerGui.BombTagHUD
check(not hud:FindFirstChild('SHOP',true) and not hud:FindFirstChild('NavSHOP',true),'all global Shop buttons removed')
node('INDEX',hud).Activated:Fire();tickFrame(.01)
check(not hud:FindFirstChild('CollectionSwitch',true),'Index has no Shop backdoor')
check(node('Item_bomb_classic',hud).ButtonCaption.Text=='EQUIP','owned Index items remain equippable')
callCount=#serverCalls;node('Item_bomb_classic',hud).Activated:Fire()
check(#serverCalls==callCount+1 and lastCall()[1]=='Equip','Index sends Equip only')
profile(lastCall()[3],9999)
check(node('Item_bomb_cobalt',hud):GetAttribute('HussDisabled'),'locked Index item is browse-only')
node('Close',hud).Activated:Fire()
-- Round, voting and AFK callbacks retain their original remote contracts.
remoteObjects.RoundState.OnClientEvent:Fire({State='ROUND',Alive=4});check(node('Alive',hud).Text:find('4'),'gameplay alive state remains wired')
remoteObjects.BombState.OnClientEvent:Fire({Active=true,CarrierUserId=42,CarrierName='Tester',EndTime=clockNow+14});check(node('Caption',node('Bomb',hud)).Text=='YOU HAVE THE BOMB','bomb carrier HUD remains wired')
node('AFK',hud).Activated:Fire();check(serverCalls[#serverCalls].remote=='BombTagAFKRequest','AFK retains original remote')
-- Destruction restores world faces, cursor, focus and all connection ownership.
local activePanel=shop() and shop().Adornee
script:Destroy();check(shop()==nil and not bound.HussStandShopCursorV12,'destroy removes SurfaceGui and render callback')
check(player:GetAttribute('HussShopBrowsingV12')==nil,'destroy clears local browsing state')
check(not activePanel or activePanel.ShopIdleV12.Enabled,'destroy restores idle world panel')
check(UserInputService.MouseBehavior==Enum.MouseBehavior.LockCenter and not UserInputService.MouseIconEnabled,'destroy restores cursor behavior and visibility')
HUD.Destroy()
check(economy.OnClientEvent:Count()==0,'HUD and stand remote subscriptions cleaned up')
assert(#failures==0,table.concat(failures,'\n'))
print('STAND_SHOP_V12 '..checks..' assertions passed')
