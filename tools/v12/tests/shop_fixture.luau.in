local workspace=Instance.new("Workspace")
workspace.CurrentCamera=camera
function workspace:GetServerTimeNow() return clockNow end
local function time() return clockNow end
local task={}
local os={clock=function() return clockNow end,time=function() return math.floor(clockNow) end}
function task.delay(seconds,fn,...)
	local item={at=clockNow+seconds,fn=fn,args=table.pack(...)}
	table.insert(pending,item)
	return item
end
function task.defer(fn,...) return task.delay(0,fn,...) end
function task.spawn(fn,...) return task.delay(0,fn,...) end
function task.cancel(item) item.cancelled=true end
local function tickFrame(dt)
	clockNow+=dt or 0
	local ready={}
	for i=#pending,1,-1 do
		if pending[i].at<=clockNow then table.insert(ready,table.remove(pending,i)) end
	end
	for _,item in ipairs(ready) do if not item.cancelled then item.fn(table.unpack(item.args,1,item.args.n)) end end
	RunService.RenderStepped:Fire(dt or 1/30)
	RunService.Heartbeat:Fire(dt or 1/30)
end


