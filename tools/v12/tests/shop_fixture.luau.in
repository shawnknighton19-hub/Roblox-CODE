-- Standalone Luau test doubles. These tests do not render Roblox GUI or simulate Studio.
local rawTypeof = typeof
local clockNow = 100
local pending = {}
local allSignals = {}
local remoteGets = {}
local checks = 0
local failures = {}
local previewCloneCount = 0
local serverCalls = {}

local function check(condition, description)
	checks += 1
	if not condition then table.insert(failures, description); print("FAIL: " .. description) end
end

local function signal()
	local s = {_connections = {}}
	function s:Connect(callback)
		local c = {Connected = true, callback = callback}
		function c:Disconnect() self.Connected = false end
		table.insert(self._connections, c)
		return c
	end
	function s:Once(callback)
		local c
		c = self:Connect(function(...) c:Disconnect(); callback(...) end)
		return c
	end
	function s:Fire(...)
		for _, c in ipairs(table.clone(self._connections)) do
			if c.Connected then c.callback(...) end
		end
	end
	function s:Count()
		local n = 0
		for _, c in ipairs(self._connections) do if c.Connected then n += 1 end end
		return n
	end
	table.insert(allSignals, s)
	return s
end

local Vector3, vector3Mt = {}, {}
vector3Mt.__index = function(t, k)
    if k == "Magnitude" then return math.sqrt(t.X*t.X+t.Y*t.Y+t.Z*t.Z) end
    if k == "Unit" then local n=t.Magnitude; assert(n>0,"zero vector"); return Vector3.new(t.X/n,t.Y/n,t.Z/n) end
    return Vector3[k]
end
function Vector3.new(x,y,z) return setmetatable({_kind="Vector3",X=x or 0,Y=y or 0,Z=z or 0},vector3Mt) end
vector3Mt.__add=function(a,b) return Vector3.new(a.X+b.X,a.Y+b.Y,a.Z+b.Z) end
vector3Mt.__sub=function(a,b) return Vector3.new(a.X-b.X,a.Y-b.Y,a.Z-b.Z) end
vector3Mt.__unm=function(a) return Vector3.new(-a.X,-a.Y,-a.Z) end
vector3Mt.__mul=function(a,b)
    if type(a)=="number" then return Vector3.new(a*b.X,a*b.Y,a*b.Z) end
    if type(b)=="number" then return Vector3.new(a.X*b,a.Y*b,a.Z*b) end
    return Vector3.new(a.X*b.X,a.Y*b.Y,a.Z*b.Z)
end
vector3Mt.__div=function(a,b) return Vector3.new(a.X/b,a.Y/b,a.Z/b) end
vector3Mt.__eq=function(a,b) return a.X==b.X and a.Y==b.Y and a.Z==b.Z end
function Vector3:Dot(b) return self.X*b.X+self.Y*b.Y+self.Z*b.Z end
function Vector3:Cross(b) return Vector3.new(self.Y*b.Z-self.Z*b.Y,self.Z*b.X-self.X*b.Z,self.X*b.Y-self.Y*b.X) end
function Vector3:Lerp(b,t) return self+(b-self)*t end
Vector3.zero=Vector3.new();Vector3.one=Vector3.new(1,1,1)
Vector3.xAxis=Vector3.new(1,0,0);Vector3.yAxis=Vector3.new(0,1,0);Vector3.zAxis=Vector3.new(0,0,1)

local CFrame, frameMt={},{}
local function frame(p,m) return setmetatable({_kind="CFrame",p=p,m=m or {1,0,0,0,1,0,0,0,1}},frameMt) end
local function rotate(m,v) return Vector3.new(m[1]*v.X+m[2]*v.Y+m[3]*v.Z,m[4]*v.X+m[5]*v.Y+m[6]*v.Z,m[7]*v.X+m[8]*v.Y+m[9]*v.Z) end
frameMt.__index=function(t,k)
    if k=="Position" or k=="p" then return rawget(t,"p") end
    if k=="Rotation" then return frame(Vector3.zero,table.clone(t.m)) end
    if k=="X" or k=="Y" or k=="Z" then return t.p[k] end
    if k=="RightVector" then return Vector3.new(t.m[1],t.m[4],t.m[7]) end
    if k=="UpVector" then return Vector3.new(t.m[2],t.m[5],t.m[8]) end
    if k=="LookVector" then return Vector3.new(-t.m[3],-t.m[6],-t.m[9]) end
    return CFrame[k]
end
frameMt.__mul=function(a,b)
    if b._kind=="Vector3" then return a.p+rotate(a.m,b) end
    assert(b._kind=="CFrame")
    local m={}
    for r=0,2 do for c=0,2 do m[r*3+c+1]=a.m[r*3+1]*b.m[c+1]+a.m[r*3+2]*b.m[c+4]+a.m[r*3+3]*b.m[c+7] end end
    return frame(a.p+rotate(a.m,b.p),m)
end
frameMt.__add=function(a,b) return frame(a.p+b,table.clone(a.m)) end
frameMt.__sub=function(a,b) return frame(a.p-b,table.clone(a.m)) end
function CFrame.new(...)
    local a={...}
    if #a==0 then return frame(Vector3.zero) end
    if type(a[1])=="table" then
        if #a==2 then return CFrame.lookAt(a[1],a[2]) end
        return frame(a[1])
    end
    local m
    if #a==12 then m={table.unpack(a,4,12)} end
    return frame(Vector3.new(a[1],a[2],a[3]),m)
end
function CFrame.Angles(x,y,z)
    local cx,sx,cy,sy,cz,sz=math.cos(x),math.sin(x),math.cos(y),math.sin(y),math.cos(z),math.sin(z)
    return frame(Vector3.zero,{1,0,0,0,cx,-sx,0,sx,cx})*frame(Vector3.zero,{cy,0,sy,0,1,0,-sy,0,cy})*frame(Vector3.zero,{cz,-sz,0,sz,cz,0,0,0,1})
end
CFrame.fromEulerAnglesXYZ=CFrame.Angles
function CFrame.lookAt(pos,target,up)
    local back=(pos-target).Unit
    local right=(up or Vector3.yAxis):Cross(back).Unit
    local upwards=back:Cross(right)
    return frame(pos,{right.X,upwards.X,back.X,right.Y,upwards.Y,back.Y,right.Z,upwards.Z,back.Z})
end
function CFrame.fromMatrix(pos,right,up,back)
    back=back or right:Cross(up)
    return frame(pos,{right.X,up.X,back.X,right.Y,up.Y,back.Y,right.Z,up.Z,back.Z})
end
function CFrame:Inverse()
    local a=self.m;local m={a[1],a[4],a[7],a[2],a[5],a[8],a[3],a[6],a[9]}
    return frame(rotate(m,-self.p),m)
end
function CFrame:ToObjectSpace(b) return self:Inverse()*b end
function CFrame:ToWorldSpace(b) return self*b end
function CFrame:PointToObjectSpace(b) return self:Inverse()*b end
function CFrame:PointToWorldSpace(b) return self*b end
function CFrame:VectorToWorldSpace(b) return rotate(self.m,b) end
function CFrame:GetComponents() return self.p.X,self.p.Y,self.p.Z,table.unpack(self.m) end
CFrame.identity=CFrame.new()

local Vector2 = {}
local vectorMt = {}
vectorMt.__index = function(t,k)
	if k == "Magnitude" then return math.sqrt(t.X*t.X+t.Y*t.Y) end
	return Vector2[k]
end
vectorMt.__eq = function(a,b) return a.X == b.X and a.Y == b.Y end
vectorMt.__add = function(a,b) return Vector2.new(a.X+b.X,a.Y+b.Y) end
vectorMt.__sub = function(a,b) return Vector2.new(a.X-b.X,a.Y-b.Y) end
vectorMt.__mul = function(a,b)
	if type(a) == "number" then return Vector2.new(a*b.X,a*b.Y) end
	return Vector2.new(a.X*b,a.Y*b)
end
function Vector2.new(x,y) return setmetatable({X=x or 0,Y=y or 0,_kind="Vector2"},vectorMt) end
Vector2.zero = Vector2.new(0,0)
Vector2.one = Vector2.new(1,1)

local UDim = {new=function(scale,offset) return {Scale=scale or 0,Offset=offset or 0,_kind="UDim"} end}
local UDim2 = {}
function UDim2.new(xs,xo,ys,yo) return {X=UDim.new(xs,xo),Y=UDim.new(ys,yo),_kind="UDim2"} end
function UDim2.fromOffset(x,y) return UDim2.new(0,x,0,y) end
function UDim2.fromScale(x,y) return UDim2.new(x,0,y,0) end

local Color3 = {}
local colorMt = {__index=Color3}
function Color3.new(r,g,b) return setmetatable({R=r,G=g,B=b,_kind="Color3"},colorMt) end
function Color3.fromRGB(r,g,b) return Color3.new(r/255,g/255,b/255) end
function Color3:Lerp(other,a) return Color3.new(self.R+(other.R-self.R)*a,self.G+(other.G-self.G)*a,self.B+(other.B-self.B)*a) end
local ColorSequence = {new=function(...) return {...} end}
local ColorSequenceKeypoint = {new=function(...) return {...} end}
local NumberSequence = {new=function(...) return {...} end}
local NumberSequenceKeypoint = {new=function(...) return {...} end}
local TweenInfo = {new=function(...) return {...} end}

local Enum = setmetatable({}, {__index=function(t,k)
	local group=setmetatable({}, {__index=function(t2,k2)
		local v={Name=k2,EnumType=k,_kind="EnumItem"}
		rawset(t2,k2,v)
		return v
	end})
	rawset(t,k,group)
	return group
end})

local function typeof(value)
	if type(value)=="table" and rawget(value,"_kind") then return value._kind end
	return rawTypeof(value)
end

local guiClasses={Frame=true,TextLabel=true,TextButton=true,ImageLabel=true,ImageButton=true,ScrollingFrame=true,ViewportFrame=true,CanvasGroup=true}
local signals={Activated=true,MouseEnter=true,MouseLeave=true,SelectionGained=true,SelectionLost=true,MouseButton1Click=true,MouseButton1Down=true,MouseButton1Up=true,InputBegan=true,InputEnded=true,InputChanged=true,Changed=true,Destroying=true,AncestryChanged=true,ChildAdded=true,ChildRemoved=true,CharacterAdded=true,CharacterRemoving=true,HealthChanged=true,Died=true,OnClientEvent=true}
local instanceMethods={}
local instanceMt={}
local camera
local insetTop=36
local function childScale(obj)
	for _,c in ipairs(obj._children) do if c.ClassName=="UIScale" then return c.Scale end end
	return 1
end
local function accumulatedScale(obj)
	if not obj or obj.ClassName=="ScreenGui" or obj.ClassName=="PlayerGui" then return 1 end
	return childScale(obj)*accumulatedScale(obj.Parent)
end
instanceMt.__index=function(t,k)
 if k=="ZIndex" and not guiClasses[t.ClassName] then error("ZIndex invalid on "..t.ClassName) end
 if k=="AbsoluteSize" and t.ClassName=="SurfaceGui" then return t.CanvasSize end
 if k=="AbsolutePosition" and t.ClassName=="SurfaceGui" then return Vector2.zero end
	if instanceMethods[k] then return instanceMethods[k] end
	if k=="ClassName" or k=="_kind" then return rawget(t,k) end
	if k=="AbsoluteSize" then
		if t.ClassName=="PlayerGui" then return camera.ViewportSize end
		if t.ClassName=="ScreenGui" then return Vector2.new(camera.ViewportSize.X,camera.ViewportSize.Y-(t.IgnoreGuiInset and 0 or insetTop)) end
		local parentSize=t.Parent and t.Parent.AbsoluteSize or camera.ViewportSize
		local s=t._props.Size or UDim2.fromOffset(0,0)
		local scale=accumulatedScale(t.Parent)*childScale(t)
		return Vector2.new(parentSize.X*s.X.Scale+s.X.Offset*scale,parentSize.Y*s.Y.Scale+s.Y.Offset*scale)
	end
	if k=="AbsolutePosition" then
		if t.ClassName=="PlayerGui" then return Vector2.zero end
		if t.ClassName=="ScreenGui" then return Vector2.new(0,t.IgnoreGuiInset and 0 or insetTop) end
		local parentSize=t.Parent and t.Parent.AbsoluteSize or camera.ViewportSize
		local parentPos=t.Parent and t.Parent.AbsolutePosition or Vector2.zero
		local p=t._props.Position or UDim2.fromOffset(0,0)
		local a=t._props.AnchorPoint or Vector2.zero
		local size=t.AbsoluteSize
		local scale=accumulatedScale(t.Parent)
		return Vector2.new(parentPos.X+parentSize.X*p.X.Scale+p.X.Offset*scale-size.X*a.X,parentPos.Y+parentSize.Y*p.Y.Scale+p.Y.Offset*scale-size.Y*a.Y)
	end
	if signals[k] then
		if not t._signals[k] then t._signals[k]=signal() end
		return t._signals[k]
	end
	if t._props[k]~=nil then return t._props[k] end
	for _,child in ipairs(t._children) do if child.Name==k then return child end end
	return nil
end
instanceMt.__newindex=function(t,k,v)
	if k=="Parent" then
		local old=t._props.Parent
		if old==v then return end
		if old then
			for i,child in ipairs(old._children) do if child==t then table.remove(old._children,i);break end end
		end
		t._props.Parent=v
		if v then table.insert(v._children,t);v.ChildAdded:Fire(t) end
		if old then old.ChildRemoved:Fire(t) end
	else t._props[k]=v end
	local changed=t._signals["property:"..k]
	if changed then changed:Fire() end
end
function instanceMethods:IsA(class)
	return self.ClassName==class or class=="Instance" or (class=="GuiObject" and guiClasses[self.ClassName]==true) or (class=="BasePart" and (self.ClassName=="Part" or self.ClassName=="WedgePart")) or (class=="GuiButton" and (self.ClassName=="TextButton" or self.ClassName=="ImageButton"))
end
function instanceMethods:GetChildren() return table.clone(self._children) end
function instanceMethods:GetDescendants()
	local result={}
	for _,child in ipairs(self._children) do
		table.insert(result,child)
		for _,nested in ipairs(child:GetDescendants()) do table.insert(result,nested) end
	end
	return result
end
function instanceMethods:FindFirstChild(name,recursive)
	for _,child in ipairs(self._children) do if child.Name==name then return child end end
	if recursive then
		for _,child in ipairs(self._children) do local found=child:FindFirstChild(name,true); if found then return found end end
	end
	return nil
end
function instanceMethods:WaitForChild(name,_timeout) return self:FindFirstChild(name) end
function instanceMethods:FindFirstChildOfClass(class)
	for _,child in ipairs(self._children) do if child:IsA(class) then return child end end
	return nil
end
function instanceMethods:FindFirstChildWhichIsA(class,recursive)
	for _,child in ipairs(recursive and self:GetDescendants() or self._children) do if child:IsA(class) then return child end end
	return nil
end
function instanceMethods:IsDescendantOf(other)
	local p=self.Parent
	while p do if p==other then return true end; p=p.Parent end
	return false
end
function instanceMethods:GetFullName() return self.Parent and self.Parent:GetFullName().."."..self.Name or self.Name end
function instanceMethods:GetAttribute(key) return self._attrs[key] end
function instanceMethods:SetAttribute(key,value)
	local previous=self._attrs[key]
	self._attrs[key]=value
	if previous~=value and self._signals["attribute:"..key] then self._signals["attribute:"..key]:Fire() end
end
function instanceMethods:GetAttributeChangedSignal(key)
	local name="attribute:"..key
	if not self._signals[name] then self._signals[name]=signal() end
	return self._signals[name]
end
function instanceMethods:GetPropertyChangedSignal(key)
	local name="property:"..key
	if not self._signals[name] then self._signals[name]=signal() end
	return self._signals[name]
end
function instanceMethods:Destroy()
	self.Destroying:Fire()
	for _,child in ipairs(table.clone(self._children)) do child:Destroy() end
	self.Parent=nil
	for _,s in pairs(self._signals) do for _,c in ipairs(s._connections) do c:Disconnect() end end
	self._destroyed=true
end
function instanceMethods:ClearAllChildren() for _,child in ipairs(self:GetChildren()) do child:Destroy() end end

local Instance={}
function instanceMethods:Clone()
 local clone=Instance.new(self.ClassName)
 for k,v in pairs(self._props) do if k~="Parent" and k~="_destroyed" then clone[k]=v end end
 for k,v in pairs(self._attrs) do clone:SetAttribute(k,v) end
 for _,c in ipairs(self:GetChildren()) do c:Clone().Parent=clone end
 if self.ClassName=="Model" and self.Parent and self.Parent.Name=="BombTagV6Previews" then previewCloneCount+=1 end
 return clone
end
function instanceMethods:GetBoundingBox() return CFrame.new(),Vector3.new(180,40,160) end
function instanceMethods:PivotTo(cf) self._pivot=cf end
function instanceMethods:GetPivot() return self._pivot or CFrame.new() end
function instanceMethods:FireServer(...) table.insert(serverCalls,{remote=self.Name,args=table.pack(...)}) end
function instanceMethods:Fire(...) self.Event:Fire(...) end

function Instance.new(class,parent)
	local obj=setmetatable({_kind="Instance",ClassName=class,_props={Name=class,Visible=true,Size=UDim2.fromOffset(100,100),Position=UDim2.fromOffset(0,0),AnchorPoint=Vector2.zero,Scale=1,Text="",BackgroundTransparency=0,TextTransparency=0,Enabled=true},_children={},_attrs={},_signals={}},instanceMt)
	if class=="Camera" then obj.FieldOfView=70 end
	if class=="Part" then obj.Size=Vector3.new(4,1,2); obj.Position=Vector3.zero;obj.CFrame=CFrame.identity;obj.Transparency=0 end
	if parent then obj.Parent=parent end
	return obj
end
