function TweenService:Create(object,_info,target)
	local t={Completed=signal()}
	function t:Play() for key,value in pairs(target) do object[key]=value end;self.Completed:Fire(Enum.PlaybackState.Completed) end
	function t:Cancel() end
	return t
end
