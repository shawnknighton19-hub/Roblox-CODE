local tagged={}
local CS={}
function CS:AddTag(o,t) tagged[o]=tagged[o] or {};tagged[o][t]=true end
function CS:HasTag(o,t) return tagged[o] and tagged[o][t]==true or false end
function CS:GetTagged(t) local out={};for o,tags in pairs(tagged) do if tags[t] then table.insert(out,o) end end;return out end
services.CollectionService=CS
local originalClone=instanceMethods.Clone
function instanceMethods:Clone()
 local copy=originalClone(self)
 for tag in pairs(tagged[self] or {}) do CS:AddTag(copy,tag) end
 return copy
end
