function M.Apply(catalog)
 for _,item in ipairs(catalog.Items) do
  local name=M.Items[item.Id]
  if name then
   item.SourceName=item.SourceName or item.Name
   item.Name=name
   item.Description=M.Crates[item.Category] and M.Crates[item.Category].Description or "Cosmetic effect."
  end
 end
 for category,info in pairs(M.Crates) do
  local crate=catalog.Crates[category]
  if crate then crate.Name=info.Name;crate.Label=info.Label;crate.Description=info.Description end
 end
