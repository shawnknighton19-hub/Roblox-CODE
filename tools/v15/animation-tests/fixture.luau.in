{{ANIMATION}}
end)()
local NativeFX=(function()
{{FX}}
end)()
local input={TouchEnabled=false,InputBegan=signal(),GetFocusedTextBox=function() return nil end}
local cas={Bound={}}
function cas:BindActionAtPriority(name,fn) self.Bound[name]=fn end
function cas:UnbindAction(name) self.Bound[name]=nil end
services.UserInputService=input;services.ContextActionService=cas
services.Debris={AddItem=function() end};services.SoundService=Instance.new('SoundService')
services.RunService.RenderStepped=signal()
function playerService:GetPlayerFromCharacter(c) for _,p in ipairs(self.members) do if p.Character==c then return p end end end
function methods:ChangeState(state) self.State=state end
function methods:Play() self.Played=true end
local schedule={}
task.delay=function(t,fn) schedule[#schedule+1]={At=clock+t,Fn=fn} end
local X=Instance.new('Folder',services.ReplicatedStorage);X.Name='HABExpansion'
for _,name in ipairs({'Config','CombatRules','HABCombatHUD','HABActionAnimationsV15','HABAbilityEffectsV15'}) do local m=Instance.new('ModuleScript',X);m.Name=name end
for _,name in ipairs({'FX','Action'}) do local m=Instance.new('RemoteEvent',X);m.Name=name;m.OnClientEvent=signal() end
local requests={}
function methods:FireServer(kind,packet) requests[#requests+1]={Kind=kind,Packet=packet} end
for _,name in ipairs({'BombSkinBuilderV12','HussCatalogV11'}) do local m=Instance.new('ModuleScript',services.ReplicatedStorage);m.Name=name end
local config={Audio={SwingId=0,ThrowId=0,AbilityId=0},DefaultAbility='Speed',Swing={Windup=.055,Cooldown=.48},Throw={Cooldown=12},VFX={}}
local hud={Pending=function() end,Reply=function() end,Notice=function() end,Hit=function() end,Destroy=function() end}
local require=function(m)
 if m.Name=='HABActionAnimationsV15' then return A elseif m.Name=='HABAbilityEffectsV15' then return NativeFX
 elseif m.Name=='Config' then return config elseif m.Name=='HABCombatHUD' then return function() return hud end
 elseif m.Name=='CombatRules' then return {Projectile=function(origin,velocity,gravity,age) return origin+velocity*age-Vector3.new(0,gravity*age*age/2,0) end}
 elseif m.Name=='BombSkinBuilderV12' then return {Apply=function() end} elseif m.Name=='HussCatalogV11' then return {ById={bomb_default={}},Defaults={Bombs='bomb_default'}} end
 error('Unknown module '..m.Name)
end
owner:SetAttribute('HussSFXMuted',true)
for _,p in ipairs(playerService.members) do
 p:SetAttribute('InRound',true);p.Character:SetAttribute('MovementAction','DiveEnd');p.Character:SetAttribute('MovementActionId',0)
 p.Character.Humanoid.MoveDirection=Vector3.zero
end
local panicExports
do
{{PANIC}}
panicExports={states=states,blocked=blocked}
