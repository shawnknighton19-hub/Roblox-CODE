local exports
do
{{CLIENT}}
exports={Pose=pose,Clear=clearPose,Poses=poses,Effects=Effects,Send=send,Predicted=predicted,Folder=folder,Missiles=missiles}
end
local assertions=0
local function check(condition,message) assertions+=1;assert(condition,message or 'Assertion '..assertions) end
local function tick(dt)
 clock+=dt or 1/60
 for i=#schedule,1,-1 do if schedule[i].At<=clock then local q=table.remove(schedule,i);q.Fn() end end
 services.RunService.PreAnimation:Fire()
 services.RunService.PreSimulation:Fire(dt or 1/60)
 services.RunService.RenderStepped:Fire(dt or 1/60)
end
local function reset(p)
 local c=p.Character;exports.Clear(c)
 c:SetAttribute('HussDodgeStartedAt',nil);c:SetAttribute('MovementAction','DiveEnd');c:SetAttribute('MovementActionId',(c:GetAttribute('MovementActionId') or 0)+1)
 c:SetAttribute('Ragdolled',false);c:SetAttribute('IsRagdoll',false);c:SetAttribute('HussBombCarrier',true)
 p:SetAttribute('HussEmotePlaying',nil);p:SetAttribute('HABModalOwnerV15',nil);p:SetAttribute('HussReducedMotion',nil)
 c.HumanoidRootPart.Anchored=false;c.Humanoid.Health=100;c.Humanoid.PlatformStand=false;c.Humanoid.Sit=false;c.Humanoid.State=Enum.HumanoidStateType.Running
 c.HumanoidRootPart.AssemblyLinearVelocity=Vector3.zero
 for _,j in ipairs(c:GetDescendants()) do if j:IsA('Motor6D') or j:IsA('AnimationConstraint') then j.Transform=CFrame.identity end end
 clock+=1
end
